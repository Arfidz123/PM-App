                  <tr>\n                        <td style=\"background-color: red; color: white; font-weight: bold; border: 1.5px solid #000; padding: 2px;\">Daya Listrik (kVA)</td>\n                        <td style=\"border: 1.5px solid #000; padding: 2px; font-weight: bold;\">: "+(o.dayaListrik||n.daya||'')+"</td>\n                        <td style=\"background-color: red; color: white; font-weight: bold; border: 1.5px solid #000; padding: 2px;\">Serial Number</td>\n                        <td style=\"border: 1.5px solid #000; padding: 2px; font-weight: bold;\">: "+('Ada'===o.gensetAda&&o.snGenset||'')+"</td>\n                      </tr>\n                      <tr>\n                        <td style=\"background-color: red; color: white; font-weight: bold; border: 1.5px solid #000; padding: 2px;\">Phasa</td>\n                        <td style=\"border: 1.5px solid #000; padding: 2px; font-weight: bold;\">: "+(o.phasaCatuan||'')+"</td>\n                        <td style=\"background-color: red; color: white; font-weight: bold; border: 1.5px solid #000; padding: 2px;\">Jenis Genset</td>\n                        <td style=\"border: 1.5px solid #000; padding: 2px; font-weight: bold;\">: "+('Ada'===o.gensetAda&&(o.engineMerk||o.engineMark||o.jenisGenset)||'')+"</td>\n                      </tr>\n                      <tr>\n                        <td style=\"background-color: red; color: white; font-weight: bold; border: 1.5px solid #000; padding: 2px;\">Pengukuran KWH</td>\n                        <td style=\"border: 1.5px solid #000; padding: 2px; font-weight: bold;\">: "+(o.pengukuranKwh||'')+"</td>\n                        <td style=\"background-color: red; color: white; font-weight: bold; border: 1.5px solid #000; padding: 2px;\">Tipe Genset</td>\n                        <td style=\"border: 1.5px solid #000; padding: 2px; font-weight: bold;\">: "+('Ada'===o.gensetAda&&o.tipeGenset||'')+"</td>\n                      </tr>\n                      <tr>\n                        <td style=\"background-color: red; color: white; font-weight: bold; border: 1.5px solid #000; padding: 2px;\">Bulan Ini</td>\n                        <td style=\"border: 1.5px solid #000; padding: 2px; font-weight: bold;\">: "+(o.bulanIni||'')+"</td>\n                        <td style=\"background-color: red; color: white; font-weight: bold; border: 1.5px solid #000; padding: 2px;\">Kapasitas</td>\n                        <td style=\"border: 1.5px solid #000; padding: 2px; font-weight: bold;\">: "+('Ada'===o.gensetAda&&o.kapasitasGenset||'')+"</td>\n                      </tr>\n                      <tr>\n                        <td style=\"background-color: red; color: white; font-weight: bold; border: 1.5px solid #000; padding: 2px;\">Bulan Lalu</td>\n                        <td style=\"border: 1.5px solid #000; padding: 2px; font-weight: bold;\">: "+(o.bulanLalu||'')+"</td>\n                        <td style=\"background-color: red; color: white; font-weight: bold; border: 1.5px solid #000; padding: 2px;\">Phasa</td>\n                        <td style=\"border: 1.5px solid #000; padding: 2px; font-weight: bold;\">: "+('Ada'===o.gensetAda&&o.phasaGenset||'')+"</td>\n                      </tr>\n                    </table>\n                    <table style=\"width: 100%; border-collapse: collapse; border: none; margin-top: 5px; margin-bottom: -15px;\">\n                      <tr>\n                        <td width=\"50%\" style=\"vertical-align: top; padding: 0; border: none;\">\n                          <table style=\"width: 100%; border-collapse: collapse; border: 3px solid #000;\">\n                            <tr style=\"background-color: red; color: white; font-weight: bold; text-align: center;\">\n                              <td colspan=\"3\" style=\"padding: 2px; border: 1.5px solid #000;\">TEGANGAN CATUAN (AC)</td>\n                            </tr>\n                            <tr style=\"text-align: center; font-weight: bold;\">\n                              <td width=\"25%\" style=\"padding: 2px; border: 1.5px solid #000;\">Phasa</td>\n                              <td width=\"25%\" style=\"padding: 2px; border: 1.5px solid #000;\">Voltage</td>\n                              <td width=\"50%\" style=\"padding: 2px; border: 1.5px solid #000;\">Tolak Ukur</td>\n                            </tr>\n                            <tr style=\"text-align: center;\">\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">R-N</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.teganganR_N||o.vRn||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.teganganR_N_TU||'220 \xb1 10%')+"</td>\n                            </tr>\n                            <tr style=\"text-align: center;\">\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">S-N</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.teganganS_N||o.vSn||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.teganganS_N_TU||'220 \xb1 10%')+"</td>\n                            </tr>\n                            <tr style=\"text-align: center;\">\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">T-N</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.teganganT_N||o.vTn||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.teganganT_N_TU||'220 \xb1 10%')+"</td>\n                            </tr>\n                            <tr style=\"text-align: center;\">\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">R-T</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.teganganR_T||o.vRt||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.teganganR_T_TU||'400 \xb1 10%')+"</td>\n                            </tr>\n                            <tr style=\"text-align: center;\">\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">S-T</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.teganganS_T||o.vSt||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.teganganS_T_TU||'400 \xb1 10%')+"</td>\n                            </tr>\n                            <tr style=\"text-align: center;\">\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">R-S</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.teganganR_S||o.vRs||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.teganganR_S_TU||'400 \xb1 10%')+"</td>\n                            </tr>\n                            <tr style=\"text-align: center;\">\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">G-N</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.teganganG_N||o.vGn||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.teganganG_N_TU||'')+"</td>\n                            </tr>\n                          </table>\n                        </td>\n                        <td width=\"6%\" style=\"border: none;\"></td>\n                        <td width=\"49%\" style=\"vertical-align: top; padding: 0; border: none;\">\n                          <table style=\"width: 89%; border-collapse: collapse; border: 3px solid #000;\">\n                            <tr style=\"background-color: red; color: white; font-weight: bold; text-align: center;\">\n                              <td colspan=\"2\" style=\"padding: 2px; border: 1.5px solid #000;\">TOTAL ARUS TERPAKAI (AC)</td>\n                            </tr>\n                            <tr style=\"text-align: center;\">\n                              <td width=\"50%\" style=\"padding: 2px; border: 1.5px solid #000;\">Phasa (A)</td>\n                              <td width=\"50%\" style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.phasaArus||o.phasaCatuan||o.phasa||'')+"</td>\n                            </tr>\n                            <tr style=\"text-align: center;\">\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">Frekuensi (Hz)</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.frekuensi||'')+"</td>\n                            </tr>\n                            <tr style=\"text-align: center;\">\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">R</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.arusPhasaR||o.arusR||'')+"</td>\n                            </tr>\n                            <tr style=\"text-align: center;\">\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">S</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.arusPhasaS||o.arusS||'')+"</td>\n                            </tr>\n                            <tr style=\"text-align: center;\">\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">T</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.arusPhasaT||o.arusT||'')+"</td>\n                            </tr>\n                            <tr style=\"background-color: red; color: white; font-weight: bold; text-align: center;\">\n                              <td colspan=\"2\" style=\"padding: 2px; border: 1.5px solid #000;\">STABILIZER</td>\n                            </tr>\n                            <tr style=\"text-align: center;\">\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">Kapasitas (kVA)</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.stabilizerKapasitas||o.kapasitasStabilizer||'')+"</td>\n                            </tr>\n                            <tr style=\"text-align: center;\">\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">Jumlah</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.stabilizerJumlah||o.jumlahStabilizer||'')+"</td>\n                            </tr>\n                          </table>\n                        </td>\n                      </tr>\n                    </table>\n                  </td>\n                  \x3c!-- COLUMN 2: VISUAL CHECK MDP --\x3e\n                  <td width=\"25%\" style=\"vertical-align: top; padding-right: 5px; border: none;\">\n                    \x3c!-- INVISIBLE SPACER TO ALIGN WITH SECOND TABLE IN COL 1 --\x3e\n                    <div style=\"visibility: hidden;\">\n                      <table style=\"width: 100%; border-collapse: collapse; border: none; margin-bottom: 5px;\">\n                        <tr><td style=\"padding: 0; vertical-align: top;\">\n                          <table style=\"width: 100%; border-collapse: collapse; border: 1.5px solid #000;\">\n                            <tr><td style=\"padding: 2px; border: 1.5px solid #000;\">&nbsp;</td></tr>\n                            <tr><td style=\"padding: 2px; border: 1.5px solid #000;\">&nbsp;</td></tr>\n                          </table>\n                        </td></tr>\n                      </table>\n                    </div>\n                    <table style=\"width: 95%; border-collapse: collapse; border: 3px solid #000;\">\n                      <tr style=\"background-color: red; color: white; font-weight: bold; text-align: center;\">\n                        <td colspan=\"2\" width=\"30%\" style=\"border: 1.5px solid #000; padding: 2px;\">Visual Check MDP</td>\n                        <td width=\"35%\" style=\"border: 1.5px solid #000; padding: 2px;\">Keterangan</td>\n                        <td width=\"35%\" style=\"border: 1.5px solid #000; padding: 2px;\">Catatan</td>\n                      </tr>\n                      <tr>\n                        <td width=\"17%\" style=\"border: 1.5px solid #000; padding: 2px;\"><b>Cek Kabel</b></td>\n                        <td width=\"10%\" style=\"border: 1.5px solid #000; padding: 2px;\">"+(o.cekKabel?': '+o.cekKabel:':')+"</td>\n                        <td style=\"border: 1.5px solid #000; padding: 2px; text-align: center;\">"+(o.cekKabelKet||'')+"</td>\n                        <td style=\"border: 1.5px solid #000; padding: 2px; text-align: center;\">Mengetahui kondisi kabel terbakar, terkelupas</td>\n                      </tr>\n                      <tr>\n                        <td style=\"border: 1.5px solid #000; padding: 2px;\"><b>Cek Baut Terminal</b></td>\n                        <td style=\"border: 1.5px solid #000; padding: 2px;\">"+(o.cekBautTerminal?': '+o.cekBautTerminal:':')+"</td>\n                        <td style=\"border: 1.5px solid #000; padding: 2px; text-align: center;\">"+(o.cekBautTerminalKet||'')+"</td>\n                        <td style=\"border: 1.5px solid #000; padding: 2px; text-align: center;\">Mengetahui tingkat kekencangan</td>\n                      </tr>\n                      <tr>\n                        <td style=\"border: 1.5px solid #000; padding: 2px;\"><b>Cek Baut MCB/MCCB</b></td>\n                        <td style=\"border: 1.5px solid #000; padding: 2px;\">"+(o.cekBautMCB?': '+o.cekBautMCB:':')+"</td>\n                        <td style=\"border: 1.5px solid #000; padding: 2px; text-align: center;\">"+(o.cekBautMCBKet||'')+"</td>\n                        <td style=\"border: 1.5px solid #000; padding: 2px; text-align: center;\">Mengetahui tingkat kekencangan</td>\n                      </tr>\n                      <tr>\n                        <td style=\"border: 1.5px solid #000; padding: 2px;\"><b>Indikator Lamp R,S,T</b></td>\n                        <td style=\"border: 1.5px solid #000; padding: 2px;\">"+(o.indikatorLamp?': '+o.indikatorLamp:':')+"</td>\n                        <td style=\"border: 1.5px solid #000; padding: 2px; text-align: center;\">"+(o.indikatorLampKet||'')+"</td>\n                        <td style=\"border: 1.5px solid #000; padding: 2px; text-align: center;\">Mengetahui kondisi mati, hilang</td>\n                      </tr>\n                      <tr>\n                        <td style=\"border: 1.5px solid #000; padding: 2px;\"><b>COS Genset</b></td>\n                        <td style=\"border: 1.5px solid #000; padding: 2px;\">"+(o.cosGenset?': '+o.cosGenset:':')+"</td>\n                        <td style=\"border: 1.5px solid #000; padding: 2px; text-align: center;\">"+(o.cosGensetKet||'')+"</td>\n                        <td style=\"border: 1.5px solid #000; padding: 2px; text-align: center;\">Mengetahui kondisi kabel terbakar, terkelupas</td>\n                      </tr>\n                    </table>\n                    <table style=\"width: 95%; border-collapse: collapse; border: 3px solid #000; margin-top: 5px;\">\n                      <tr style=\"background-color: red; color: white; font-weight: bold; text-align: center;\">\n                        <td colspan=\"5\" style=\"padding: 2px; border: 1.5px solid #000;\">PENGECEKAN ARRESTER</td>\n                      </tr>\n                      <tr style=\"background-color: red; color: white; font-weight: bold; text-align: center;\">\n                        <td width=\"5%\" style=\"padding: 2px; border: 1.5px solid #000;\">PHASA</td>\n                        <td width=\"25%\" style=\"padding: 2px; border: 1.5px solid #000;\">ARRESTER KWH BOX</td>\n                        <td width=\"25%\" style=\"padding: 2px; border: 1.5px solid #000;\">ARRESTER ACPDB</td>\n                        <td width=\"25%\" style=\"padding: 2px; border: 1.5px solid #000;\">ARRESTER RECTIFIER</td>\n                        <td width=\"20%\" style=\"padding: 2px; border: 1.5px solid #000;\">KETERANGAN</td>\n                      </tr>\n                      <tr style=\"text-align: center;\">\n                        <td style=\"padding: 2px; border: 1.5px solid #000;\">R</td>\n                        <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.kwhBoxR||o.arresterKwhR||'OK')+"</td>\n                        <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.acpdbR||o.arresterAcpdbR||'OK')+"</td>\n                        <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rectifierR||o.arresterRectifierR||'OK')+"</td>\n                        <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.arresterKetR||'')+"</td>\n                      </tr>\n                      <tr style=\"text-align: center;\">\n                        <td style=\"padding: 2px; border: 1.5px solid #000;\">S</td>\n                        <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.kwhBoxS||o.arresterKwhS||'OK')+"</td>\n                        <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.acpdbS||o.arresterAcpdbS||'OK')+"</td>\n                        <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rectifierS||o.arresterRectifierS||'OK')+"</td>\n                        <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.arresterKetS||'')+"</td>\n                      </tr>\n                      <tr style=\"text-align: center;\">\n                        <td style=\"padding: 2px; border: 1.5px solid #000;\">T</td>\n                        <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.kwhBoxT||o.arresterKwhT||'OK')+"</td>\n                        <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.acpdbT||o.arresterAcpdbT||'OK')+"</td>\n                        <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rectifierT||o.arresterRectifierT||'OK')+"</td>\n                        <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.arresterKetT||'')+"</td>\n                      </tr>\n                      <tr style=\"text-align: center;\">\n                        <td style=\"padding: 2px; border: 1.5px solid #000;\">N</td>\n                        <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.kwhBoxN||o.arresterKwhN||'OK')+"</td>\n                        <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.acpdbN||o.arresterAcpdbN||'OK')+"</td>\n                        <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rectifierN||o.arresterRectifierN||'OK')+"</td>\n                        <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.arresterKetN||'')+"</td>\n                      </tr>\n                    </table>\n                  </td>\n                  \x3c!-- COLUMN 3: RECTIFIER --\x3e\n                  <td width=\"14%\" style=\"vertical-align: top; padding-right: 5px; border: none;\">\n                    <table style=\"width: 90%; border-collapse: collapse; border: 3px solid #000;\">\n                      <tr style=\"background-color: red; color: white; font-weight: bold; text-align: center;\">\n                        <td width=\"30%\" style=\"border: 1.5px solid #000; padding: 2px;\">Rectifier #1</td>\n                        <td width=\"10%\" style=\"border: 1.5px solid #000; padding: 2px;\">Status</td>\n                        <td width=\"60%\" style=\"border: 1.5px solid #000; padding: 2px;\">Keterangan</td>\n                      </tr>\n                      <tr>\n                        <td style=\"border: 1.5px solid #000; padding: 2px; text-align: center;\">Kebersihan Rack</td>\n                        <td style=\"border: 1.5px solid #000; padding: 2px; text-align: center;\">"+(o.rect1KebersihanRack||'')+'</td><td style="border: 1.5px solid #000; padding: 2px;">'+(o.rect1KebersihanRackKet||'')+"</td>\n                      </tr>\n                      <tr>\n                        <td style=\"border: 1.5px solid #000; padding: 2px; text-align: center;\">Cek Baut Kabinet</td>\n                        <td style=\"border: 1.5px solid #000; padding: 2px; text-align: center;\">"+(o.rect1CekBautKabinet||'')+'</td><td style="border: 1.5px solid #000; padding: 2px;">'+(o.rect1CekBautKabinetKet||'')+"</td>\n                      </tr>\n                      <tr style=\"background-color: red; color: white; font-weight: bold; text-align: center;\">\n                        <td width=\"25%\" style=\"border: 1.5px solid #000; padding: 2px;\">Rectifier #2</td>\n                        <td width=\"10%\" style=\"border: 1.5px solid #000; padding: 2px;\">Status</td>\n                        <td width=\"65%\" style=\"border: 1.5px solid #000; padding: 2px;\">Keterangan</td>\n                      </tr>\n                      <tr>\n                        <td style=\"border: 1.5px solid #000; padding: 2px; text-align: center;\">Kebersihan Rack</td>\n                        <td style=\"border: 1.5px solid #000; padding: 2px; text-align: center;\">"+(o.rect2KebersihanRack||'')+'</td><td style="border: 1.5px solid #000; padding: 2px;">'+(o.rect2KebersihanRackKet||'')+"</td>\n                      </tr>\n                      <tr>\n                        <td style=\"border: 1.5px solid #000; padding: 2px; text-align: center;\">Cek Baut Kabinet</td>\n                        <td style=\"border: 1.5px solid #000; padding: 2px; text-align: center;\">"+(o.rect2CekBautKabinet||'')+'</td><td style="border: 1.5px solid #000; padding: 2px;">'+(o.rect2CekBautKabinetKet||'')+"</td>\n                      </tr>\n                      <tr style=\"background-color: red; color: white; font-weight: bold; text-align: center;\">\n                        <td width=\"25%\" style=\"border: 1.5px solid #000; padding: 2px;\">Rectifier #3</td>\n                        <td width=\"10%\" style=\"border: 1.5px solid #000; padding: 2px;\">Status</td>\n                        <td width=\"65%\" style=\"border: 1.5px solid #000; padding: 2px;\">Keterangan</td>\n                      </tr>\n                      <tr>\n                        <td style=\"border: 1.5px solid #000; padding: 2px; text-align: center;\">Kebersihan Rack</td>\n                        <td style=\"border: 1.5px solid #000; padding: 2px; text-align: center;\">"+(o.rect3KebersihanRack||'')+'</td><td style="border: 1.5px solid #000; padding: 2px;">'+(o.rect3KebersihanRackKet||'')+"</td>\n                      </tr>\n                      <tr>\n                        <td style=\"border: 1.5px solid #000; padding: 2px; text-align: center;\">Cek Baut Kabinet</td>\n                        <td style=\"border: 1.5px solid #000; padding: 2px; text-align: center;\">"+(o.rect3CekBautKabinet||'')+'</td><td style="border: 1.5px solid #000; padding: 2px;">'+(o.rect3CekBautKabinetKet||'')+"</td>\n                      </tr>\n                    </table>\n                    <table style=\"width: 90%; border-collapse: collapse; border: 3px solid #000; margin-top: 5px;\">\n                      <tr style=\"background-color: red; color: white; font-weight: bold; text-align: center;\">\n                        <td width=\"60%\" style=\"padding: 2px; border: 1.5px solid #000;\">Grounding System</td>\n                        <td width=\"40%\" style=\"padding: 2px; border: 1.5px solid #000;\">Keterangan</td>\n                      </tr>\n                      <tr style=\"text-align: center;\">\n                        <td style=\"padding: 2px; border: 1.5px solid #000;\">Pengukuran Bak Kontrol Outdoor</td>\n                        <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.grOutdoor||o.groundingOutdoor?String(o.grOutdoor||o.groundingOutdoor).toLowerCase().includes('ohm')?o.grOutdoor||o.groundingOutdoor:(o.grOutdoor||o.groundingOutdoor)+' Ohm':'Ohm')+"</td>\n                      </tr>\n                      <tr style=\"text-align: center;\">\n                        <td style=\"padding: 2px; border: 1.5px solid #000;\">Pengukuran Bak Kontrol Indoor</td>\n                        <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.grIndoor||o.groundingIndoor?String(o.grIndoor||o.groundingIndoor).toLowerCase().includes('ohm')?o.grIndoor||o.groundingIndoor:(o.grIndoor||o.groundingIndoor)+' Ohm':'Ohm')+"</td>\n                      </tr>\n                      <tr style=\"text-align: center;\">\n                        <td style=\"padding: 2px; border: 1.5px solid #000;\">System Grounding</td>\n                        <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(f.systemGrounding||o.systemGrounding||'Single')+"</td>\n                      </tr>\n                      <tr style=\"text-align: center;\">\n                        <td style=\"padding: 12px; border: 1.5px solid #000;\">Catatan</td>\n                        <td style=\"padding: 12px; border: 1.5px solid #000;\">"+(f.grCatatan||o.grCatatan||o.catatanGrounding||f.catatanGrounding||'')+"</td>\n                      </tr>\n                    </table>\n                  </td>\n                  \x3c!-- COLUMN 4: STEP PENGUJIAN --\x3e\n                  <td width=\"25%\" rowspan=\"2\" style=\"vertical-align: top; border:none; padding: 0; padding-left: 1.5px;\">\n<table style=\"width: 100%; border-collapse: collapse; border: 3px solid #000; font-size: 16px; line-height: 1.5; background-color: #fff; height: 100%;\">\n  \n  <tr style=\"background-color: red; color: white; text-align: center; font-weight: bold; height: 1px;\">\n    <td colspan=\"2\" style=\"padding: 6px; border-bottom: 3px solid #000; font-size: 16px; letter-spacing: 0.5px;\">STEP PENGUJIAN</td>\n  </tr>\n  \n  <tr>\n    <td colspan=\"2\" style=\"padding: 12px; border: none; text-align: left; vertical-align: top; height: 100%;\">\n      \n      <div style=\"font-weight: bold; font-size: 16px; margin-bottom: 8px;\">PENGUJIAN BATTERY BEBAN DUMMYLOAD</div>\n      <div style=\"margin-bottom: 4px;\">1. Matikan sumber tegangan utama PLN. Pastikan sistem baterai back up / sistem genset bekerja</div>\n      <div style=\"margin-bottom: 4px;\">2. Disconnect baterai yang akan diuji</div>\n      <div style=\"margin-bottom: 4px;\">3. Atur beban dummy load sesuai beban POP</div>\n      <div style=\"margin-bottom: 4px;\">4. Pastikan baterai dalam kondisi charging 100% sebelum dilakukan pengujian</div>\n      <div style=\"margin-bottom: 4px;\">5. Koneksikan baterai ke dummyload dan pastikan polaritas tidak terbalik</div>\n      <div style=\"margin-left: 10px; margin-top: 10px; margin-bottom: 10px;\">\n        <div>Contoh berikut adalah spesifikasi tegangan standby battery Narada Tipe 12NDF100 :</div>\n        <div style=\"margin: 8px 0; text-align: center;\"><img src=\"data:image/png;base64,\" style=\"max-width: 95%; height: auto; max-height: 140px; object-fit: contain;\" /></div>\n        <div style=\"margin: 12px 0; text-align: center;\"><img src=\"data:image/png;base64,\" style=\"max-width: 95%; height: auto; max-height: 220px; object-fit: contain;\" /></div>\n        <div style=\"margin-top: 8px; margin-bottom: 10px;\">Pada datasheet terlihat nilai tegangan standby = 2,25V/cell atau setara dengan (2,25 x 6 = 13,5 V) per baterai atau setara dengan (13,5 x 4 = 54 V) per bank</div>\n      </div>\n      <div style=\"margin-bottom: 4px;\">6. Catat hasil pengukuran tegangan baterai per 15 menit selama 8 jam</div>\n      <div style=\"margin-bottom: 15px;\">7. Jika hasil pengukuran tegangan baterai sudah lebih kecil dari end voltage baterai, maka hentikan pengukuran.<br/>&nbsp;&nbsp;&nbsp;&nbsp;Hidupkan kembali source power PLN. End voltage batery adalah 4x10,8 atau 43,2 VDC</div>\n      \n      <div style=\"font-weight: bold; font-size: 16px; margin-top: 15px; margin-bottom: 8px;\">LANGKAH-LANGKAH UJI KAPASITAS BATERAI</div>\n      <div style=\"margin-bottom: 6px;\">1. Pastikan baterai secara visual dalam kondisi baik (tidak gembung dan konektor tidak berkarat)</div>\n      <div style=\"margin-bottom: 6px;\">2. Pastikan sistem backup power POP (Bila genset harus dinyalakan terlebih dahulu gensetnya atau baterai cadangan terlebih dahulu</div>\n      <div style=\"margin-left: 15px; margin-top: 10px; margin-bottom: 10px;\">\n        <div style=\"font-weight: bold; font-size: 16px; margin-bottom: 6px;\">2. 1 Metode pemasangan baterai backup</div>\n        <div style=\"margin-bottom: 4px;\">a. Cabut fuse battery bank 1 dan 2</div>\n        <div style=\"margin: 6px 0 10px 0; text-align: center;\"><img src=\"data:image/png;base64,\" style=\"max-width: 95%; height: auto; max-height: 160px; object-fit: contain;\" /></div>\n        <div style=\"margin-bottom: 4px;\">b. Lepas dan isolasi satu persatu ujung kabel pada terminal battery yang akan diuji</div>\n        <div style=\"margin-bottom: 4px;\">c. Siapkan satu bank battery untuk backup yang sudah dirangkai seri untuk diintegrasikan ke rectifier</div>\n        <div style=\"margin: 6px 0 10px 0; text-align: center;\"><img src=\"data:image/png;base64,\" style=\"max-width: 95%; height: auto; max-height: 140px; object-fit: contain;\" /></div>\n        <div style=\"margin-bottom: 4px;\">d. Berikut contoh spesifikasi tegangan standby battery narada 100 ah seri 12NDF100</div>\n        <div style=\"margin: 6px 0 6px 0; text-align: center;\"><img src=\"data:image/png;base64,\" style=\"max-width: 95%; height: auto; max-height: 140px; object-fit: contain;\" /></div>\n        <div style=\"margin-left: 10px; margin-bottom: 8px;\">Nilai tegangan standby = 2,23 ~ 2,27 V / cell atau setara dengan = 13,38 ~ 13,62 V / baterai atau setara dengan 53,52 ~ 54,48 V / bank.</div>\n        <div style=\"margin-bottom: 4px;\">e. Koneksikan baterai backup ke rectifier, pastikan polaritas tidak terbalik</div>\n        <div style=\"margin: 6px 0 10px 0; text-align: center;\"><img src=\"data:image/jpeg;base64,\" style=\"max-width: 95%; height: auto; max-height: 220px; object-fit: contain;\" /></div>\n        <div style=\"margin-bottom: 4px;\">f. Ukur kembali tegangan pada terminal fuse dan pastikan tegangan pada 48 \u2013 54 VDC</div>\n        <div style=\"margin-bottom: 4px;\">g. Setelah dipastikan koneksikan kembali fuse battery.</div>\n      </div>\n      <div style=\"margin-bottom: 6px;\">3. Pastikan semua perangkat sudah terbackup (bila PLN off tidak mati)</div>\n      <div style=\"margin-bottom: 6px;\">4. Ukur tegangan setiap bank baterai per sellnya dan masukkan pada tabel uji kapasitas di menit 0</div>\n      <div style=\"margin-bottom: 6px;\">5. Uji kapasitas baterai dapat dimulai dengan metode tanpa atau dengan dummy load</div>\n    </td>\n  </tr>\n  \n  <tr style=\"background-color: red; color: white; text-align: center; font-weight: bold; height: 1px;\">\n    <td width=\"50%\" style=\"padding: 5px; border-right: 3px solid #000; border-top: 3px solid #000; font-size: 16px;\">PELAKSANA</td>\n    <td width=\"50%\" style=\"padding: 5px; border-top: 3px solid #000; font-size: 16px;\">PENANGGUNG JAWAB</td>\n  </tr>\n  \n  <tr style=\"height: 1px;\">\n    <td height=\"175px\" style=\"border-right: 3px solid #000; vertical-align: bottom; text-align: center; padding-bottom: 10px;\">&nbsp;</td>\n    <td height=\"175px\" style=\"vertical-align: bottom; text-align: center; padding-bottom: 10px;\">&nbsp;</td>\n  </tr>\n</table>\n                  </td>\n                </tr>\n                <tr>\n                  <td colspan=\"3\" style=\"vertical-align: top; border: none; padding-top: 5px; padding-right: 5px; \">\n                    <table style=\"width: 100%; border-collapse: collapse;\">\n                      <tr>\n                        <td width=\"45%\" style=\"vertical-align: top; padding-right: 5px; border:none;\">\n                          <table style=\"width: 90%; border-collapse: collapse; border: 3px solid #000;\">\n                            <tr style=\"background-color: red; color: white; font-weight: bold; text-align: center;\">\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">DESCRIPTION</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">RECTIFIER #1</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">RECTIFIER #2</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">RECTIFIER #3</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">ACUAN</td>\n                            </tr>\n                            <tr style=\"text-align: center;\">\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">Input AC (Phasa)</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect1InputAC||o.recti1InputAc||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect2InputAC||o.recti2InputAc||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect3InputAC||o.recti3InputAc||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\"></td>\n                            </tr>\n                            <tr style=\"text-align: center;\">\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">Merk Rectifier</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect1Merk||o.recti1Merk||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect2Merk||o.recti2Merk||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect3Merk||o.recti3Merk||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\"></td>\n                            </tr>\n                            <tr style=\"text-align: center;\">\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">Tipe Rectifier</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect1Tipe||o.recti1Tipe||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect2Tipe||o.recti2Tipe||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect3Tipe||o.recti3Tipe||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\"></td>\n                            </tr>\n                            <tr style=\"text-align: center;\">\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">Kapasitas Slot (Unit)</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect1KapasitasSlot||o.recti1KapasitasSlot||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect2KapasitasSlot||o.recti2KapasitasSlot||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect3KapasitasSlot||o.recti3KapasitasSlot||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\"></td>\n                            </tr>\n                            <tr style=\"text-align: center;\">\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">Serial Number</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect1SN||o.recti1Sn||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect2SN||o.recti2Sn||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect3SN||o.recti3Sn||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\"></td>\n                            </tr>\n                            <tr style=\"text-align: center;\">\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">Tipe Modul</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect1TipeModul||o.recti1TipeModul||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect2TipeModul||o.recti2TipeModul||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect3TipeModul||o.recti3TipeModul||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\"></td>\n                            </tr>\n                            <tr style=\"text-align: center;\">\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">Modul Terpasang (Jml)</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect1ModulJml||o.recti1ModulTerpasang||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect2ModulJml||o.recti2ModulTerpasang||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect3ModulJml||o.recti3ModulTerpasang||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\"></td>\n                            </tr>\n                            <tr style=\"text-align: center;\">\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">Kapasitas Modul (A)</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect1KapasitasModul||o.recti1KapasitasModul||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect2KapasitasModul||o.recti2KapasitasModul||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect3KapasitasModul||o.recti3KapasitasModul||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\"></td>\n                            </tr>\n                            <tr style=\"text-align: center;\">\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">Arus Beban (A)</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect1ArusBeban||o.recti1ArusBeban||x[0]&&x[0].arusBeban||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect2ArusBeban||o.recti2ArusBeban||x[1]&&x[1].arusBeban||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect3ArusBeban||o.recti3ArusBeban||x[2]&&x[2].arusBeban||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\"></td>\n                            </tr>\n                            <tr style=\"text-align: center;\">\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">Tegangan Input (V)</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect1TegInput||o.recti1TeganganInput||x[0]&&x[0].tegInput||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect2TegInput||o.recti2TeganganInput||x[1]&&x[1].tegInput||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect3TegInput||o.recti3TeganganInput||x[2]&&x[2].tegInput||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\"></td>\n                            </tr>\n                            <tr style=\"text-align: center;\">\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">Tegangan Floating (V)</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect1TegFloating||o.recti1TeganganFloating||x[0]&&x[0].tegFloating||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect2TegFloating||o.recti2TeganganFloating||x[1]&&x[1].tegFloating||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect3TegFloating||o.recti3TeganganFloating||x[2]&&x[2].tegFloating||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\"></td>\n                            </tr>\n                            <tr style=\"text-align: center;\">\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">Tegangan Equalizing (V)</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect1TegEqualizing||o.recti1TeganganEqualizing||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect2TegEqualizing||o.recti2TeganganEqualizing||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect3TegEqualizing||o.recti3TeganganEqualizing||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\"></td>\n                            </tr>\n                            <tr style=\"text-align: center;\">\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">LVD Threshold (V)</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect1Lvd||o.recti1LvdThreshold||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect2Lvd||o.recti2LvdThreshold||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px solid #000;\">"+(o.rect3Lvd||o.recti3LvdThreshold||'')+"</td>\n                              <td style=\"padding: 2px; border: 1.5px sol