"padding: 1px 2px; border: none;\">Type</td>\n                  <td style=\"padding: 1px 2px; border: none;\">: "+n('atsType')+"</td>\n                </tr>\n                <tr>\n                  <td style=\"padding: 1px 2px; border: none;\">Genset Type</td>\n                  <td style=\"padding: 1px 2px; border: none;\">: "+n('tipeGenset')+"</td>\n                  <td style=\"padding: 1px 2px; border: none;\">Controller</td>\n                  <td style=\"padding: 1px 2px; border: none;\">: "+n('atsController')+"</td>\n                </tr>\n                <tr>\n                  <td style=\"padding: 1px 2px; border: none;\">Engine Mark</td>\n                  <td style=\"padding: 1px 2px; border: none;\">: "+n('engineMerk')+"</td>\n                  <td style=\"padding: 1px 2px; border: none;\">COS</td>\n                  <td style=\"padding: 1px 2px; border: none;\">: "+n('atsCos')+"</td>\n                </tr>\n              </table>\n              <table style=\"width: 100%; border-collapse: collapse; font-size: 8px; margin-bottom: 5px; border: 1px solid #000;\">\n                <tr style=\"background-color: red; color: white; font-weight: bold; text-align: center;\">\n                  <td colspan=\"3\" style=\"padding: 2px; border: 1px solid #000;\">ITEM</td>\n                </tr>\n"+g+"              </table>\n              <table style=\"width: 100%; border-collapse: collapse; font-size: 8px; margin-bottom: 5px; border: 1px solid #000;\">\n                <tr style=\"background-color: red; color: white; font-weight: bold; text-align: center;\">\n                  <td colspan=\"3\" style=\"padding: 2px; border: 1px solid #000;\">PENGETESAN</td>\n                </tr>\n                <tr style=\"background-color: red; color: white; font-weight: bold;\">\n                  <td colspan=\"3\" style=\"padding: 2px 3px; border: 1px solid #000;\">Start Engine Manual</td>\n                </tr>\n                <tr><td colspan=\"3\" style=\"padding: 1px 3px; border: 1px solid #000; font-style: italic; font-size: 7.5px;\">ATS dikondisikan pada Mode Manual terlebih dahulu</td></tr>\n"+p+"                <tr style=\"background-color: red; color: white; font-weight: bold;\">\n                  <td colspan=\"3\" style=\"padding: 2px 3px; border: 1px solid #000;\">Start Engine Auto</td>\n                </tr>\n                <tr>\n                  <td style=\"padding: 1px 3px; border: 1px solid #000; width: 36%;\">Panel ATS Test</td>\n                  <td style=\"padding: 1px 3px; border: 1px solid #000; text-align: left; width: 45px;\">: "+n('testAutoPanelAts')+"</td>\n                  <td style=\"padding: 1px 3px; border: 1px solid #000; color: #555;\">Ket: "+n('testAutoPanelAtsKet')+"</td>\n                </tr>\n                <tr><td colspan=\"3\" style=\"padding: 1px 3px; border: 1px solid #000; font-style: italic; font-size: 7.5px;\">(kondisi switch otomatis pada saat PLN OFF)</td></tr>\n"+s+"                <tr style=\"font-weight: bold;\">\n                  <td colspan=\"3\" style=\"padding: 2px 3px; border: 1px solid #000;\">Engine Auto STOP</td>\n                </tr>\n"+x+"              </table>\n              <table style=\"width: 100%; border-collapse: collapse; font-size: 8px; margin-bottom: 5px; border: 1px solid #000;\">\n                <tr style=\"background-color: red; color: white; font-weight: bold; text-align: center;\">\n                  <td colspan=\"3\" style=\"padding: 2px; border: 1px solid #000;\">KEBERSIHAN</td>\n                </tr>\n"+w+"              </table>\n              <div style=\"border: 1px solid #000; padding: 3px; font-size: 8px; min-height: 35px;\">\n                <b>Note:</b> "+(n('catatanGenset')||n('noteGenset')||'')+"\n              </div>\n            </td>\n            <td style=\"width: 42%; vertical-align: top; padding: 4px; border: none;\">\n              <table style=\"width: 100%; border-collapse: collapse; font-size: 8px; margin-bottom: 5px; border: 1px solid #000;\">\n                \x3c!-- PEMIPAAN & BAHAN BAKAR --\x3e\n                <tr style=\"background-color: red; color: white; font-weight: bold; text-align: center;\">\n                  <td colspan=\"3\" style=\"padding: 2px; border: 1px solid #000;\">Pemipaan &amp; Bahan Bakar</td>\n                </tr>\n                <tr><td style=\"padding: 1px 3px; border: 1px solid #000; width: 48%;\">Tangki Utama</td><td style=\"padding: 1px 3px; border: 1px solid #000; text-align: left; width: 45px;\">: "+n('tangkiUtama')+'</td><td style="padding: 1px 3px; border: 1px solid #000; color: #555;">Ket: '+n('tangkiUtamaKet')+"</td></tr>\n                <tr><td style=\"padding: 1px 3px; border: 1px solid #000;\">Tangki Eksternal</td><td style=\"padding: 1px 3px; border: 1px solid #000; text-align: left;\">: "+n('tangkiEksternal')+'</td><td style="padding: 1px 3px; border: 1px solid #000; color: #555;">Ket: '+n('tangkiEksternalKet')+"</td></tr>\n                <tr><td style=\"padding: 1px 3px; border: 1px solid #000;\">Pipa Solar</td><td style=\"padding: 1px 3px; border: 1px solid #000; text-align: left;\">: "+n('pipaSolar')+'</td><td style="padding: 1px 3px; border: 1px solid #000; color: #555;">Ket: '+n('pipaSolarKet')+"</td></tr>\n                <tr><td style=\"padding: 1px 3px; border: 1px solid #000;\">Valve Gate Fuel Sys</td><td style=\"padding: 1px 3px; border: 1px solid #000; text-align: left;\">: "+n('valveGateFuelSys')+'</td><td style="padding: 1px 3px; border: 1px solid #000; color: #555;">Ket: '+n('valveGateFuelSysKet')+"</td></tr>\n                \x3c!-- POMPA SOLAR --\x3e\n                <tr><td style=\"padding: 1px 3px; border: 1px solid #000;\">Pompa Solar</td><td colspan=\"2\" style=\"padding: 1px 3px; border: 1px solid #000;\">: "+(n('pompaSolar')||'')+"</td></tr>\n                <tr><td style=\"padding: 1px 3px; border: 1px solid #000;\">Test Pompa Kondisi Auto</td><td style=\"padding: 1px 3px; border: 1px solid #000; text-align: left;\">: "+n('testPompaKondisiAuto')+'</td><td style="padding: 1px 3px; border: 1px solid #000; color: #555;">Ket: '+n('testPompaKondisiAutoKet')+"</td></tr>\n                <tr><td style=\"padding: 1px 3px; border: 1px solid #000;\">Test Pompa Kondisi Manual</td><td style=\"padding: 1px 3px; border: 1px solid #000; text-align: left;\">: "+n('testPompaKondisiManual')+'</td><td style="padding: 1px 3px; border: 1px solid #000; color: #555;">Ket: '+n('testPompaKondisiManualKet')+"</td></tr>\n                <tr><td style=\"padding: 1px 3px; border: 1px solid #000;\">Panel Pompa Solar</td><td style=\"padding: 1px 3px; border: 1px solid #000; text-align: left;\">: "+n('panelPompaSolar')+'</td><td style="padding: 1px 3px; border: 1px solid #000; color: #555;">Ket: '+n('panelPompaSolarKet')+"</td></tr>\n                <tr><td style=\"padding: 1px 3px; border: 1px solid #000;\">Pelampung Pompa Solar</td><td style=\"padding: 1px 3px; border: 1px solid #000; text-align: left;\">: "+n('pelampungPompaSolar')+'</td><td style="padding: 1px 3px; border: 1px solid #000; color: #555;">Ket: '+n('pelampungPompaSolarKet')+"</td></tr>\n                <tr><td style=\"padding: 1px 3px; border: 1px solid #000;\">Kapasitas Tangki Utama</td><td colspan=\"2\" style=\"padding: 1px 3px; border: 1px solid #000;\">: "+(n('kapasitasTangkiUtama')?n('kapasitasTangkiUtama')+' ltr':'')+"</td></tr>\n                <tr><td style=\"padding: 1px 3px; border: 1px solid #000;\">Sisa BBM pengecekan bulan lalu</td><td colspan=\"2\" style=\"padding: 1px 3px; border: 1px solid #000;\">: "+(n('sisaBbmPengecekanBulanLalu')?n('sisaBbmPengecekanBulanLalu')+' ltr':'')+"</td></tr>\n                <tr><td style=\"padding: 1px 3px; border: 1px solid #000;\">Sisa BBM pengecekan bulan sekarang</td><td colspan=\"2\" style=\"padding: 1px 3px; border: 1px solid #000;\">: "+(n('sisaBbmPengecekanBulanSekarang')?n('sisaBbmPengecekanBulanSekarang')+' ltr':'')+"</td></tr>\n                <tr><td style=\"padding: 1px 3px; border: 1px solid #00